# Section 14: CAMERA
# ---------------------------------------------------------------------------

def get_camera_pos(obj_data, phase, phase_t):
    bd = 3.2
    if phase == 'appear':
        te = ease_in_out_cubic(float(phase_t))
        dist = bd * (1.0 + (1.0 - te) * 2.5)
        a = float(phase_t) * 0.3
        return np.array([np.sin(a)*dist*0.15, 0.4, dist], dtype=np.float32)
    elif phase == 'hold':
        a = float(phase_t) * 0.4
        return np.array([np.sin(a)*0.5*bd, 0.3, np.cos(a)*bd], dtype=np.float32)
    elif phase == 'transition':
        if phase_t < 0.5:
            te = ease_in_out_cubic(float(phase_t)*2.0)
            dist = bd * (1.0 + te*9.0)
            return np.array([0, 0.5, dist], dtype=np.float32)
        else:
            te = ease_in_out_cubic((float(phase_t)-0.5)*2.0)
            dist = bd * (1.0 + (1.0-te)*9.0)
            return np.array([0, 0.4, dist], dtype=np.float32)
    return np.array([0, 0.4, bd], dtype=np.float32)

# ---------------------------------------------------------------------------
# Section 15: FRAME GENERATOR
# ---------------------------------------------------------------------------

SDF_FUNCS = [
    sdf_quark, sdf_proton, sdf_hydrogen, sdf_dna, sdf_coronavirus,
    sdf_rbc, sdf_ant, sdf_human, sdf_eiffel_tower, sdf_everest,
    sdf_earth, sdf_jupiter, sdf_sun, sdf_solar_system, sdf_lightyear,
    sdf_milkyway, sdf_local_group, sdf_observable_universe,
]


def generate_object_frames(obj_idx, obj_data, starfield, fonts):
    sdf_func = SDF_FUNCS[obj_idx]
    n_objects = len(SDF_FUNCS)
    target = np.array([0, 0, 0], dtype=np.float32)
    frames = []

    # Appear
    for f in range(F_APPEAR):
        t = f / max(F_APPEAR-1, 1)
        scale = 0.3 + 0.7 * ease_out_bounce(t)
        cam = get_camera_pos(obj_data, 'appear', t)
        render = render_frame(sdf_func, obj_data, cam, target, t, scale)
        comp = blend_with_starfield(render, starfield, alpha=min(t*2, 1.0))
        img = Image.fromarray(comp); draw = ImageDraw.Draw(img)
        draw_ui_overlay(img, draw, fonts, obj_data, obj_idx, n_objects, 'appear', t)
        frames.append(np.array(img))

    # Hold
    for f in range(F_HOLD):
        t = f / max(F_HOLD-1, 1)
        cam = get_camera_pos(obj_data, 'hold', t)
        render = render_frame(sdf_func, obj_data, cam, target, t, 1.0)
        comp = blend_with_starfield(render, starfield, alpha=1.0)
        img = Image.fromarray(comp); draw = ImageDraw.Draw(img)
        draw_ui_overlay(img, draw, fonts, obj_data, obj_idx, n_objects, 'hold', t)
        frames.append(np.array(img))

    # Transition
    for f in range(F_TRANSITION):
        t = f / max(F_TRANSITION-1, 1)
        cam = get_camera_pos(obj_data, 'transition', t)
        if t < 0.5:
            render = render_frame(sdf_func, obj_data, cam, target, t, 1.0)
            bg_a = 1.0 - t*1.4
        else:
            render = np.zeros((RENDER_H, RENDER_W, 3), dtype=np.uint8)
            bg_a = 0.15 + (t-0.5)*1.7
        comp = blend_with_starfield(render, starfield, alpha=max(0.05, bg_a))
        img = Image.fromarray(comp); draw = ImageDraw.Draw(img)
        draw_ui_overlay(img, draw, fonts, obj_data, obj_idx, n_objects, 'transition', t)
        frames.append(np.array(img))

    return frames

