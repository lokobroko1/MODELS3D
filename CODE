    out_frames = total_written * _FRAME_REPEAT
    print(f"Frames      : {total_written} rendered → {out_frames} output at {FPS_OUTPUT} fps")
    print(f"Duration    : {out_frames/FPS_OUTPUT:.1f}s  ({out_frames/FPS_OUTPUT/60:.1f} min)")
    print(f"Objects     : {n_obj}")
    print("=" * 60)


if __name__ == "__main__":
