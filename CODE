def draw_scale_bar(draw, fonts, idx, n):
    bx, by = 60, HEIGHT - 55
    bw, bh = WIDTH - 120, 7
    draw.rectangle([bx-1, by-1, bx+bw+1, by+bh+1], fill=(20, 20, 40))
    draw.rectangle([bx, by, bx+bw, by+bh], fill=(40, 40, 70))
    progress = idx / max(n-1, 1)
    fw = int(bw * progress)
    if fw > 0:
        for px in range(fw):
            tb = px / max(fw, 1)
            r = int(60 + tb*80); g = int(100 + tb*80); b = int(220 + tb*35)
            draw.line([(bx+px, by), (bx+px, by+bh)], fill=(r, g, min(b, 255)))
    for i in range(n):
        tx = bx + int(bw * i / max(n-1, 1))
        col = (180, 180, 255) if i <= idx else (80, 80, 120)
        draw.rectangle([tx-1, by-4, tx+1, by+bh+4], fill=col)


def draw_ui_overlay(img, draw, fonts, obj, idx, n, phase, phase_t):
    draw.rectangle([0, 0, WIDTH, 75], fill=(4, 3, 18, 180))
    title = "SIZE COMPARISON: FROM QUARK TO OBSERVABLE UNIVERSE"
    draw_text_with_glow(draw, title, (WIDTH//2 - 470, 15), fonts['title'], (240,240,255), (80,80,200), 3)
    counter = f"#{idx+1:02d} / {n}"
    draw_text_with_glow(draw, counter, (WIDTH-170, 22), fonts['subtitle'], (180,180,220), (60,60,120))

    alpha = 1.0
    if phase == 'appear': alpha = float(phase_t)
    elif phase == 'transition': alpha = max(0.0, 1.0 - float(phase_t)*2.0)

    if alpha > 0.02:
        px = 55
        color = obj['color']; glow = obj['glow_color']
        cat_c = tuple(min(255, int(c*0.75)) for c in color)
        draw_text_with_glow(draw, obj['category'], (px, HEIGHT//2-195), fonts['subtitle'], cat_c, glow, 2)
        draw_text_with_glow(draw, obj['name'], (px, HEIGHT//2-155), fonts['name'], color, glow, 7)
        draw_text_with_glow(draw, f"SI: {obj['si_label']}", (px, HEIGHT//2-65), fonts['body'], (210,220,255), (50,60,130))
        draw_text_with_glow(draw, f"US: {obj['us_label']}", (px, HEIGHT//2-28), fonts['body'], (220,210,200), (70,60,50))
        draw.line([(px, HEIGHT//2+8), (px+420, HEIGHT//2+8)], fill=(80,80,120), width=1)
        for i, fact in enumerate(obj['facts'][:3]):
            draw_text_with_glow(draw, f"• {fact}", (px, HEIGHT//2+22+i*38), fonts['body'], (195,200,210), (35,40,75))

    draw_scale_bar(draw, fonts, idx, n)
    draw.text((WIDTH-240, HEIGHT-28), "Generated with Python + NumPy", font=fonts['small'], fill=(60,60,90))

