# ---------------------------------------------------------------------------
# Section 8: RAYMARCHING ENGINE (optimized)
# ---------------------------------------------------------------------------

def raymarch(ray_origins, ray_dirs, sdf_func, t_anim):
    H, W = ray_origins.shape[:2]
    t = np.full((H, W), 0.1, dtype=np.float32)
    hit_mask = np.zeros((H, W), dtype=bool)
    for step in range(MAX_STEPS):
        active = (t < MAX_DIST) & (~hit_mask)
        if not np.any(active):
            break
        p = ray_origins + ray_dirs * t[..., np.newaxis]
        p_flat = p[active].reshape(-1, 3).astype(np.float32)
        d = sdf_func(p_flat, t_anim).astype(np.float32)
        step_mask = np.zeros((H, W), dtype=np.float32)
        step_mask[active] = d
        new_hits = active & (step_mask < SURF_DIST) & (step_mask > -SURF_DIST * 5)
        hit_mask |= new_hits
        t = np.where(active & ~new_hits, t + np.maximum(step_mask, SURF_DIST * 0.3), t)
    t = np.where(hit_mask, t, MAX_DIST)
    return t, hit_mask


def estimate_normal(p_flat, sdf_func, t_anim, eps=0.004):
    eps_arr = np.float32(eps)
    dx = np.array([eps_arr, 0, 0], dtype=np.float32)
    dy = np.array([0, eps_arr, 0], dtype=np.float32)
    dz = np.array([0, 0, eps_arr], dtype=np.float32)
    nx = sdf_func(p_flat + dx, t_anim) - sdf_func(p_flat - dx, t_anim)
    ny = sdf_func(p_flat + dy, t_anim) - sdf_func(p_flat - dy, t_anim)
    nz = sdf_func(p_flat + dz, t_anim) - sdf_func(p_flat - dz, t_anim)
    n = np.stack([nx, ny, nz], axis=-1)
    nl = np.sqrt(np.sum(n ** 2, axis=-1, keepdims=True)) + 1e-8
    return (n / nl).astype(np.float32)

# ---------------------------------------------------------------------------
# Section 9: LIGHTING (optimized — 3 AO samples instead of 5)
# ---------------------------------------------------------------------------

def phong_lighting(normals, view_dir, light_dir, ambient=0.15, diffuse=0.7,
                   specular=0.4, shininess=32.0, rim_strength=0.3):
    ndotl = np.maximum(np.sum(normals * light_dir, axis=-1), 0.0)
    light = ambient + diffuse * ndotl
    half_vec = light_dir + view_dir
    half_len = np.sqrt(np.sum(half_vec ** 2, axis=-1, keepdims=True)) + 1e-8
    half_vec = half_vec / half_len
    ndoth = np.maximum(np.sum(normals * half_vec, axis=-1), 0.0)
    light += specular * (ndoth ** shininess)
    rim = 1.0 - np.maximum(np.sum(normals * view_dir, axis=-1), 0.0)
    light += rim_strength * (rim ** 3)
    return light


def compute_ao(hit_pos, normals, sdf_func, t_anim):
    ao = np.zeros(hit_pos.shape[0], dtype=np.float32)
    for i in range(1, 4):  # 3 samples instead of 5
        step = 0.08 * i
        p = hit_pos + normals * step
        d = sdf_func(p, t_anim).astype(np.float32)
        ao += (step - np.clip(d, 0.0, step)) / (2.0 ** i)
    return np.clip(1.0 - 2.5 * ao, 0.0, 1.0)

# ---------------------------------------------------------------------------
# Section 10: RENDER PIPELINE (renders at RENDER_W x RENDER_H)
# ---------------------------------------------------------------------------

def render_frame(sdf_func, obj_data, camera_pos, camera_target, t_anim, scale=1.0):
    """Render at low res, return [RENDER_H, RENDER_W, 3] uint8."""
    camera_pos = np.asarray(camera_pos, dtype=np.float32)
    camera_target = np.asarray(camera_target, dtype=np.float32)
    fov = np.pi / 3.8
    aspect = RENDER_W / RENDER_H

    forward = camera_target - camera_pos
    fwd_len = np.linalg.norm(forward)
    forward = forward / fwd_len if fwd_len > 1e-8 else np.array([0, 0, -1], dtype=np.float32)

    world_up = np.array([0, 1, 0], dtype=np.float32)
    if abs(np.dot(forward, world_up)) > 0.99:
        world_up = np.array([0, 0, 1], dtype=np.float32)
    right = np.cross(forward, world_up)
    right /= (np.linalg.norm(right) + 1e-8)
    up = np.cross(right, forward)
    up /= (np.linalg.norm(up) + 1e-8)

    ys, xs = np.mgrid[0:RENDER_H, 0:RENDER_W].astype(np.float32)
    ndc_x = (2.0 * (xs + 0.5) / RENDER_W - 1.0) * np.tan(fov / 2) * aspect
    ndc_y = -(2.0 * (ys + 0.5) / RENDER_H - 1.0) * np.tan(fov / 2)

    ray_dirs = (forward[None, None, :] + right[None, None, :] * ndc_x[:, :, None]
                + up[None, None, :] * ndc_y[:, :, None])
    ray_lens = np.sqrt(np.sum(ray_dirs ** 2, axis=-1, keepdims=True)) + 1e-8
    ray_dirs = (ray_dirs / ray_lens).astype(np.float32)
    ray_origins = np.broadcast_to(camera_pos, (RENDER_H, RENDER_W, 3)).copy().astype(np.float32)

    def scaled_sdf(p_in, ta):
        return sdf_func(p_in / scale, ta) * scale

    hit_dist, hit_mask = raymarch(ray_origins, ray_dirs, scaled_sdf, t_anim)

    frame = np.zeros((RENDER_H, RENDER_W, 3), dtype=np.float32)

    if np.any(hit_mask):
        hit_pos = (ray_origins[hit_mask] + ray_dirs[hit_mask] * hit_dist[hit_mask, None]).astype(np.float32)
        normals = estimate_normal(hit_pos, scaled_sdf, t_anim)
        view_dir = (-ray_dirs[hit_mask]).astype(np.float32)

        light_pos = np.array([3.0, 4.0, 5.0], dtype=np.float32)
        light_dir = light_pos - hit_pos
        light_dir /= (np.sqrt(np.sum(light_dir ** 2, axis=-1, keepdims=True)) + 1e-8)

        lighting = phong_lighting(normals, view_dir, light_dir,
                                  ambient=0.18, diffuse=0.65, specular=0.45,
                                  shininess=40.0, rim_strength=0.35)
        ao = compute_ao(hit_pos, normals, scaled_sdf, t_anim)
        lighting *= ao

        base_color = np.array(obj_data['color'], dtype=np.float32) / 255.0
        lit_color = base_color[None, :] * lighting[:, None]

        fill_dir = np.array([-0.5, 0.3, -0.7], dtype=np.float32)
        fill_dir /= (np.linalg.norm(fill_dir) + 1e-8)
        fill_ndotl = np.maximum(np.sum(normals * fill_dir, axis=-1), 0.0)
        lit_color += np.array([0.1, 0.15, 0.3], dtype=np.float32)[None, :] * (fill_ndotl * 0.25)[:, None]
        frame[hit_mask] = np.clip(lit_color, 0.0, 1.0)

    frame_u8 = np.clip(frame * 255, 0, 255).astype(np.uint8)
    frame_f = frame_u8.astype(np.float32)

    if np.any(hit_mask):
        glow_color = np.array(obj_data['glow_color'], dtype=np.float32) / 255.0
        glow_mask = gaussian_filter(hit_mask.astype(np.float32), sigma=3.0)  # smaller sigma for low res
        for c in range(3):
            frame_f[:, :, c] += glow_mask * glow_color[c] * 80.0

    return np.clip(frame_f, 0, 255).astype(np.uint8)

# ---------------------------------------------------------------------------
# Section 11: STARFIELD (generated at full res)
# ---------------------------------------------------------------------------

def generate_starfield():
    bg = np.zeros((HEIGHT, WIDTH, 3), dtype=np.float32)
    rng = np.random.RandomState(42)
    n_stars = 3000
    sx = rng.randint(0, WIDTH, n_stars)
    sy = rng.randint(0, HEIGHT, n_stars)
    sb = np.clip(rng.exponential(0.5, n_stars), 0.0, 1.0)
    for i in range(n_stars):
        b = float(sb[i])
        x, y = int(sx[i]), int(sy[i])
        bg[y, x] = [b, b*0.9, b*0.8]
        if b > 0.7 and 1 < x < WIDTH-2 and 1 < y < HEIGHT-2:
            for dy, dx in [(-1,0),(1,0),(0,-1),(0,1)]:
                bg[y+dy, x+dx] = [b*0.4, b*0.36, b*0.32]
    nebula_colors = [np.array([0.4,0.1,0.6]), np.array([0.1,0.2,0.7]),
                     np.array([0.6,0.1,0.2]), np.array([0.1,0.5,0.4]), np.array([0.3,0.2,0.5])]
    for nc in nebula_colors:
        cx = rng.randint(100, WIDTH-100); cy = rng.randint(100, HEIGHT-100)
        sigma = rng.randint(120, 320)
        ys, xs = np.ogrid[:HEIGHT, :WIDTH]
        nebula = np.exp(-((xs-cx)**2 + (ys-cy)**2) / (2.0*sigma**2)).astype(np.float32)
        bg += nebula[:, :, None] * nc[None, None, :] * 0.18
    for c in range(3):
        bg[:, :, c] = gaussian_filter(bg[:, :, c], sigma=1.2)
    return np.clip(bg * 255, 0, 255).astype(np.uint8)


def blend_with_starfield(frame_lowres, starfield, alpha=1.0):
    """Upscale low-res render to full HD, composite over starfield."""
    # Upscale with Lanczos
    img_low = Image.fromarray(frame_lowres)
    img_hd = img_low.resize((WIDTH, HEIGHT), Image.LANCZOS)
    frame_f = np.array(img_hd).astype(np.float32)
    star_f = starfield.astype(np.float32)

    luminance = np.sum(frame_f, axis=-1)
    obj_mask = (luminance > 8.0).astype(np.float32)
    obj_mask_smooth = gaussian_filter(obj_mask, sigma=2.0)
    obj_mask_smooth = np.clip(obj_mask_smooth, 0, 1)[:, :, None]

    result = (frame_f * obj_mask_smooth + star_f * (1.0 - obj_mask_smooth))
    result = (result * alpha + star_f * (1.0 - alpha) * 0.3
              + np.array(BG_COLOR, dtype=np.float32)[None, None, :] * (1.0 - alpha) * 0.7)
    return np.clip(result, 0, 255).astype(np.uint8)

