def sdf_quark(p, t):
    pulse = 0.15 + 0.03 * np.sin(t * np.pi * 6)
    center = np.array([0, 0, 0], dtype=np.float32)
    core = sdf_sphere(p, center, pulse)
    ring1 = sdf_torus(p, center, 0.35, 0.04)
    R60 = rot_x(np.radians(60.0))
    ring2 = sdf_torus(apply_rotation(p, R60), center, 0.35, 0.04)
    R120 = rot_x(np.radians(120.0))
    ring3 = sdf_torus(apply_rotation(p, R120), center, 0.35, 0.04)
    glow = sdf_sphere(p, center, 0.55)
    d = sdf_smooth_union(core, ring1, k=0.08)
    d = sdf_smooth_union(d, ring2, k=0.08)
    d = sdf_smooth_union(d, ring3, k=0.08)
    d = sdf_smooth_union(d, glow, k=0.12)
    return d


def sdf_proton(p, t):
    q1 = np.array([0.3, 0, 0], dtype=np.float32)
    q2 = np.array([-0.15, 0.26, 0], dtype=np.float32)
    q3 = np.array([-0.15, -0.26, 0], dtype=np.float32)
    d = sdf_smooth_union(sdf_sphere(p, q1, 0.18), sdf_sphere(p, q2, 0.18), k=0.06)
    d = sdf_smooth_union(d, sdf_sphere(p, q3, 0.18), k=0.06)
    d = sdf_smooth_union(d, sdf_cylinder(p, q1, q2, 0.05), k=0.04)
    d = sdf_smooth_union(d, sdf_cylinder(p, q2, q3, 0.05), k=0.04)
    d = sdf_smooth_union(d, sdf_cylinder(p, q3, q1, 0.05), k=0.04)
    d = sdf_smooth_union(d, sdf_sphere(p, np.zeros(3, dtype=np.float32), 0.55), k=0.10)
    return d


def sdf_hydrogen(p, t):
    center = np.zeros(3, dtype=np.float32)
    nucleus = sdf_sphere(p, center, 0.12)
    shell = np.abs(sdf_sphere(p, center, 0.8)) - 0.05
    torus1 = sdf_torus(p, center, 0.8, 0.03)
    torus2 = sdf_torus(apply_rotation(p, rot_z(np.radians(45.0))), center, 0.8, 0.03)
    d = sdf_smooth_union(nucleus, shell, k=0.05)
    d = sdf_smooth_union(d, torus1, k=0.04)
    d = sdf_smooth_union(d, torus2, k=0.04)
    return d


def sdf_dna(p, t):
    two_pi = 2.0 * np.pi
    d = np.full(p.shape[0], 1e9, dtype=np.float32)
    pts_l, pts_r = [], []
    for i in range(21):
        angle = i * (two_pi / 10.0) + t * np.pi
        y = i * 0.12 - 1.2
        pts_l.append(np.array([0.25 * np.cos(angle), y, 0.25 * np.sin(angle)], dtype=np.float32))
        pts_r.append(np.array([0.25 * np.cos(angle + np.pi), y, 0.25 * np.sin(angle + np.pi)], dtype=np.float32))
    for i in range(20):
        d = np.minimum(d, sdf_capsule(p, pts_l[i], pts_l[i+1], 0.04))
        d = np.minimum(d, sdf_capsule(p, pts_r[i], pts_r[i+1], 0.04))
        ml = (pts_l[i] + pts_l[i+1]) * 0.5
        mr = (pts_r[i] + pts_r[i+1]) * 0.5
        d = np.minimum(d, sdf_capsule(p, ml, mr, 0.03))
    return d


def sdf_coronavirus(p, t):
    center = np.zeros(3, dtype=np.float32)
    d = sdf_sphere(p, center, 0.45)
    golden = (1.0 + np.sqrt(5.0)) / 2.0
    for k in range(20):
        theta = np.arccos(1.0 - 2.0 * (k + 0.5) / 20)
        phi = 2.0 * np.pi * k / golden
        dir_v = np.array([np.sin(theta)*np.cos(phi), np.cos(theta), np.sin(theta)*np.sin(phi)], dtype=np.float32)
        base = dir_v * 0.45
        tip = dir_v * 0.75
        d = np.minimum(d, sdf_cylinder(p, base, tip, 0.04))
        d = np.minimum(d, sdf_sphere(p, tip, 0.07))
    return d


def sdf_rbc(p, t):
    p_flat = np.stack([p[:, 0], p[:, 1] * 2.5, p[:, 2]], axis=-1).astype(np.float32)
    base = sdf_torus(p_flat, np.zeros(3, dtype=np.float32), 0.35, 0.28)
    shape = sdf_subtract(base, sdf_sphere(p, np.array([0, 0.12, 0], dtype=np.float32), 0.22))
    shape = sdf_subtract(shape, sdf_sphere(p, np.array([0, -0.12, 0], dtype=np.float32), 0.22))
    return shape


