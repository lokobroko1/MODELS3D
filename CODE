    print("[2/3] Loading fonts...")
    fonts = load_fonts()

    print(f"[3/3] Rendering {n_obj} objects...")

    output_file = "size_comparison_3d.mp4"
    writer = imageio.get_writer(output_file, fps=FPS_OUTPUT, codec='libx264',
                                quality=8, macro_block_size=1)

    total_written = 0
    for i, obj in enumerate(tqdm(OBJECTS, desc="Objects", unit="obj")):
        tqdm.write(f"  -> [{i+1:02d}/{n_obj}] {obj['name']}")
