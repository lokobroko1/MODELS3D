def load_fonts():
    fonts = {}
    paths = [
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
        "/usr/share/fonts/truetype/freefont/FreeSansBold.ttf",
        "/usr/share/fonts/truetype/ubuntu/Ubuntu-B.ttf",
        "/System/Library/Fonts/Helvetica.ttc",
        "C:/Windows/Fonts/arialbd.ttf",
        "C:/Windows/Fonts/arial.ttf",
    ]
    found = None
    for p in paths:
        if os.path.exists(p):
            found = p; break
    sizes = {'title': 44, 'name': 66, 'subtitle': 34, 'body': 27, 'small': 21}
    for key, size in sizes.items():
        if found:
            try:
                fonts[key] = ImageFont.truetype(found, size); continue
            except Exception: pass
        fonts[key] = ImageFont.load_default()
    return fonts


def draw_text_with_glow(draw, text, pos, font, color, glow_color, glow_radius=4):
    x, y = pos
    for ddx in range(-glow_radius, glow_radius+1):
        for ddy in range(-glow_radius, glow_radius+1):
            dsq = ddx*ddx + ddy*ddy
            if 0 < dsq <= glow_radius*glow_radius:
                a = 1.0 - (dsq**0.5) / glow_radius
                gc = tuple(int(c * a * 0.55) for c in glow_color)
                draw.text((x+ddx, y+ddy), text, font=font, fill=gc)
    draw.text((x, y), text, font=font, fill=color)

